# Keep source PDFs used by the report
!Images/*.pdf
!Images/**/*.pdf

# Build output directory
tex-builds/

# Temporary and swap files
*.swp
*.swo
*~
*.tmp
.DS_Store
Thumbs.db

# IDE and editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.vscode-evals.log

# Node/npm (if used for build tools)
node_modules/
package-lock.json
yarn.lock

# Python (if used for scripts)
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Local analysis/cache directories
.codegraph/
